/**
 * Ray-MMD ReForge: Post-SSGI Ambient Occlusion Composite
 *
 * Module: PostProcessAOComposite.fxsub
 * Applies screen-space ambient occlusion to the fully composited ShadingMap
 * (direct + IBL + GI) as a final multiplicative pass after all GI.
 *
 * AO is NOT applied during ShadingOpacity (IBL/sun) or SSGIFinalCombine.
 * It is applied here so that it darkens the total radiance including GI,
 * preventing GI from washing out contact shadows and crevices.
 *
 * Specular AO (bent-normal GTSO) is still applied during ShadingImageBasedLighting
 * before SSR overlays, since SSR already covers mirror-specular paths.
 */

#ifndef RAY_MMD_POST_PROCESS_AO_COMPOSITE_FXSUB
#define RAY_MMD_POST_PROCESS_AO_COMPOSITE_FXSUB

#if SSDO_QUALITY > 0 && (IBL_QUALITY || SUN_LIGHT_ENABLE)

/**
 * Applies Jimenez multi-bounce AO to the fully composited radiance buffer.
 * Glass and emissive materials are passed through unmodified.
 *
 * @param uvCoord  Screen UV (TEXCOORD0)
 * @param viewDir  View-space ray direction (TEXCOORD1, unused but required by ScreenSpaceQuadVS)
 * @return         AO-darkened radiance with alpha passthrough
 */
float4 AOCompositePS(in float2 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
    float4 sceneColor = tex2Dlod(ShadingMapSamp, float4(uvCoord, 0.0f, 0.0f));

    MaterialParam mat;
    DecodeGbuffer(
        tex2Dlod(Gbuffer5Map, float4(uvCoord, 0.0f, 0.0f)),
        tex2Dlod(Gbuffer6Map, float4(uvCoord, 0.0f, 0.0f)),
        tex2Dlod(Gbuffer7Map, float4(uvCoord, 0.0f, 0.0f)),
        tex2Dlod(Gbuffer8Map, float4(uvCoord, 0.0f, 0.0f)),
        mat);

    // Emissive / glass: no AO darkening
    bool isEmissiveOrGlass = (mat.lightModel == SHADINGMODELID_GLASS ||
                              mat.lightModel == SHADINGMODELID_EMISSIVE);
    if (isEmissiveOrGlass)
        return sceneColor;

    bool  isSkin    = (mat.lightModel == SHADINGMODELID_SKIN ||
                       mat.lightModel == SHADINGMODELID_SUBSURFACE);
    float rawAO     = tex2Dlod(SSDOMapSamp, float4(uvCoord, 0.0f, 0.0f)).w;
    float ssao      = min(rawAO, mat.visibility);
    float skinAO    = lerp(1.0f, ssao, SKIN_AO_STRENGTH);
    float effectiveAO = isSkin ? skinAO : (ssao * ssao); // quadratic for crevice depth on non-skin

    // Jimenez multi-bounce AO: preserves inter-reflected color tint in occluded areas
    float3 aBounce   = 2.0404f * mat.albedo - 0.3324f;
    float3 bBounce   = -4.7951f * mat.albedo + 0.6417f;
    float3 cBounce   = 2.7552f * mat.albedo + 0.6903f;
    float3 coloredAO = max(effectiveAO,
                           ((effectiveAO * aBounce + bBounce) * effectiveAO + cBounce) * effectiveAO);

    sceneColor.rgb *= coloredAO;
    return sceneColor;
}

#endif // SSDO_QUALITY > 0

#endif // RAY_MMD_POST_PROCESS_AO_COMPOSITE_FXSUB
