/**
 * Ray-MMD ReForge: Screen-Space Path Tracing (SSPT / RTGI) Raymarch & Radiance Gather
 *
 * Module: SSPT_Trace.fxsub
 * Independent Screen-Space Path Tracing Raymarcher based on qUINT RTGI.
 * Gathers hemisphere indirect radiance with golden angle spiral sampling,
 * thickness-gated surface intersection, secondary bounce feedback, and environment fallback.
 */

#ifndef RAY_MMD_SSPT_TRACE_FXSUB
#define RAY_MMD_SSPT_TRACE_FXSUB

#include "shader/SSPT/SSPT_Common.fxsub"
#include "shader/BilateralCommon.fxsub"

#if IBL_QUALITY
/**
 * Minimal 2-tap decode of the checkerboard-packed EnvLightMap.
 */
float3 SampleSkyRadiance(float2 skyUv)
{
	float4 packed = tex2Dlod(EnvLightMapSamp, float4(skyUv, 0.0f, 0.0f));
	float4 neighbor = tex2Dlod(EnvLightMapSamp, float4(skyUv + float2(ViewportOffset2.x, 0.0f), 0.0f, 0.0f));
	bool pattern = (frac((skyUv.x * ViewportSize.x + skyUv.y * ViewportSize.y) * 0.5f) < 0.5f);
	float3 ycbcr = pattern ? float3(packed.rg, neighbor.g) : float3(packed.r, neighbor.g, packed.g);
	return DecodeYcbcr(ycbcr);
}
#endif

/**
 * Screen-Space Path Tracing (RTGI) Primary Radiance Gather Pixel Shader.
 */
float4 SSPTPassPS(in float4 uvCoord : TEXCOORD0, in float3 viewDir : TEXCOORD1) : COLOR
{
	float zOrigin = GetSSPTLinearDepth(uvCoord.xy);
	if (!(zOrigin > 0.0f && zOrigin < 1000.0f))
		clip(-1);

	float4 projInfo = GetProjConstant();
	float3 nOrigin = GetSSPTNormal(uvCoord.xy);
	float3 pOrigin = GetViewPosition(projInfo, uvCoord.xy, zOrigin);

	// Construct orthonormal tangent space basis matrix around surface normal
	float3x3 tbn = BuildTangentMatrix(nOrigin);

	// Receiver shading model check
	int receiverModel = (int)floor(tex2Dlod(Gbuffer8Map, float4(uvCoord.xy, 0.0f, 0.0f)).a);
	if (receiverModel == SHADINGMODELID_GLASS)
		return 0.0f;
	bool receiverIsSkin = (receiverModel == SHADINGMODELID_SKIN || receiverModel == SHADINGMODELID_SUBSURFACE);

	// World gather radius scaling
	float maxWorldDistance = max(mSSGIScale * SSPT_SAMPLE_RADIUS * 2.5f, 4.0f) * clamp(mSSGIConeAngle * 2.0f, 0.5f, 3.0f);

	float2 screenPixel = uvCoord.xy * ViewportSize;
#if AA_QUALITY == 6
	int frameCounter = (int)fmod(time * 60.0f, 8.0f);
#else
	int frameCounter = 0;
#endif

	// Spatiotemporal dither initialization (qUINT spiral stratification)
	float ign = InterleavedGradientNoise(screenPixel, frameCounter);
	float ditherElev = PseudoRandom(screenPixel);
	float bayerVal = SSPT_Bayer1D[frameCounter % 8];

	float ipixel = ign * 255.0f;
	float index = ipixel * 8.0f + bayerVal;
	float sampleJitter = index / (256.0f * 8.0f);

	float angle = SSPT_GOLDEN_ANGLE * index;
	float sinA, cosA;
	sincos(angle, sinA, cosA);
	float2 sampleDir = float2(sinA, cosA);

	float3 totalRadiance = 0.0f;
	float totalOcclusion = 0.0f;

	[loop]
	for (int r = 0; r < SSPT_RAY_COUNT; ++r)
	{
		float rayProgress = frac((float(r) + sampleJitter) / float(SSPT_RAY_COUNT));

		// Cosine-weighted hemisphere distribution (Lambertian)
		float cosTheta = sqrt(lerp(0.01f, 0.98f, rayProgress));
		float sinTheta = sqrt(max(0.0f, 1.0f - cosTheta * cosTheta));

		// Tangent space ray direction rotated to view space
		float3 rayDirLocal = float3(sampleDir * sinTheta, cosTheta);
		float3 rayDir = normalize(mul(rayDirLocal, tbn));

		// Advance golden angle spiral for next ray
		sampleDir = mul(sampleDir, SSPT_ROTX);

#if SSPT_ISOMETRIC_SAMPLING
		float rayDirXY = length(rayDir.xy);
		float currentRayDist = maxWorldDistance * rsqrt(rayDirXY * rayDirXY + 1e-6f);
#else
		float currentRayDist = maxWorldDistance;
#endif

		// Camera near plane clipping
		if (rayDir.z < -1e-4f)
			currentRayDist = min(currentRayDist, -0.95f * zOrigin / rayDir.z);

		// Project ray end into screen space for boundary / sky lookup
		float3 pEnd = pOrigin + rayDir * currentRayDist;
		float2 uvEnd = (pEnd.xy / max(pEnd.z, 1e-3f) - projInfo.zw) / projInfo.xy;
		float2 deltaUV = uvEnd - uvCoord.xy;

		float intersected = 0.0f;
		float3 hitRadiance = 0.0f;
		bool insideScreen = true;
		float stepJitter = frac(ditherElev + float(r) * 0.61803398875f);

		[loop]
		for (int s = 1; s <= SSPT_STEPS && insideScreen; ++s)
		{
			float sNorm = (float(s) + stepJitter) / float(SSPT_STEPS);
			// Quadratic step progression for dense near-field contacts and wide reach
			float lambda = sNorm * sqrt(sNorm);
			float3 pRay = pOrigin + rayDir * (lambda * currentRayDist);

			float2 rayUV = (pRay.xy / max(pRay.z, 1e-3f) - projInfo.zw) / projInfo.xy;

			if (rayUV.x < 0.002f || rayUV.x > 0.998f || rayUV.y < 0.002f || rayUV.y > 0.998f)
			{
				insideScreen = false;
				break;
			}

			float4 g8Sample = tex2Dlod(Gbuffer8Map, float4(rayUV, 0.0f, 0.0f));
			float zSample = g8Sample.r;

			if (zSample > 1e-3f && zSample < 1000.0f)
			{
				float zDiff = pRay.z - zSample;
				int hitModel = (int)floor(g8Sample.a);

				// Glass is transparent dielectric: rays transmit through instead of reflecting diffuse bounce
				if (hitModel == SHADINGMODELID_GLASS)
					continue;

				bool isEmissive = (hitModel == SHADINGMODELID_EMISSIVE);
				bool isSkinEmitter = (hitModel == SHADINGMODELID_SKIN || hitModel == SHADINGMODELID_SUBSURFACE);

				float rayDist = lambda * currentRayDist;
				float dynamicThickness = max(0.08f, 0.04f + rayDist * 0.035f * SSPT_Z_THICKNESS);
				if (isEmissive)
					dynamicThickness = max(dynamicThickness, 0.35f);

				if (zDiff >= -0.02f && zDiff <= dynamicThickness)
				{
					float3 pSample = GetViewPosition(projInfo, rayUV, zSample);
					float3 diffOrigin = pSample - pOrigin;
					float distSq = dot(diffOrigin, diffOrigin);

					if (distSq > 0.005f)
					{
						float3 nHit = GetSSPTNormal(rayUV);
						float cosEmitter = isEmissive ? saturate(dot(-nHit, rayDir) * 0.7f + 0.3f) : saturate(dot(-nHit, rayDir));
						float cosReceiver = saturate(dot(nOrigin, rayDir));

						if (cosEmitter > 0.01f || isEmissive)
						{
							float x = saturate(zDiff / dynamicThickness);
							float thickWeight = 1.0f - (x * x * (3.0f - 2.0f * x));

							float dist = sqrt(distSq);
							float distRatio = saturate(dist / maxWorldDistance);
							float rayFade = saturate(1.0f - sNorm);
							float fade = saturate(1.0f - distRatio) * rayFade;
							fade = fade * fade * (3.0f - 2.0f * fade);

							float2 edgeDist = min(rayUV, 1.0f - rayUV);
							float edgeFade = smoothstep(0.0f, 0.08f, min(edgeDist.x, edgeDist.y));

							float invDistFalloff = 1.0f / (1.0f + dist * (isEmissive ? 0.02f : 0.035f));
							float nearContactDamping = smoothstep(0.04f, 0.25f, dist);
							float atten = fade * edgeFade * invDistFalloff * (isEmissive ? smoothstep(0.01f, 0.15f, dist) : nearContactDamping);

							intersected = saturate(thickWeight * (1.0f - distRatio));

							float3 sampleColor = clamp(tex2Dlod(ShadingMapSamp, float4(rayUV, 0.0f, 0.0f)).rgb, 0.0f, 60.0f);

							if (isEmissive)
							{
								float emissiveBoost = lerp(1.0f, 3.0f, mDbgSSGIEmissiveBoost);
								sampleColor *= emissiveBoost;
							}
							else if (isSkinEmitter && !receiverIsSkin)
							{
								sampleColor *= SKIN_GI_EMISSION_SCALE;
							}

#if SSPT_BOUNCES
							// Multi-bounce secondary bounce gather
							float3 nextBounce = clamp(tex2Dlod(SSGIMapSamp, float4(rayUV, 0.0f, 0.0f)).rgb, 0.0f, 20.0f);
							sampleColor += nextBounce * SSPT_BOUNCE_WEIGHT;
#endif

							float emitterVis = tex2Dlod(SSGIVisibilityMapSamp, float4(rayUV, 0.0f, 0.0f)).a;
							float hitWeight = thickWeight * cosEmitter * cosReceiver * atten * emitterVis;

							hitRadiance = sampleColor * hitWeight;
							break;
						}
					}
				}
			}
		}

		// Seamless Environment / Sky IBL fallback for escaped or boundary rays (matching SSGI)
		if (intersected < 0.85f)
		{
			float2 skyUv = saturate(uvCoord.xy + deltaUV);
			float skyDepth = GetSSPTLinearDepth(skyUv);
			if (skyDepth <= 1e-4f)
			{
				float NdotSky = saturate(dot(nOrigin, rayDir));
				if (NdotSky > 0.0f)
				{
#if IBL_QUALITY
					float3 skyColor = SampleSkyRadiance(skyUv);
#else
					float3 skyColor = srgb2linear(tex2Dlod(ScnSamp, float4(skyUv, 0.0f, 0.0f)).rgb);
#endif
					float skyWeight = NdotSky * lerp(SSPT_SKY_LIGHT_AMOUNT, 1.00f, mDbgSSGISkyLight) * (1.0f - intersected);
					hitRadiance += clamp(skyColor, 0.0f, 10.0f) * skyWeight;
				}
			}
		}

		totalRadiance += hitRadiance;
		totalOcclusion += intersected;
	}

	float3 avgRadiance = totalRadiance / float(SSPT_RAY_COUNT);
	float avgOcclusion = totalOcclusion / float(SSPT_RAY_COUNT);

	float giGain = PI * lerp(lerp(1.0f, 8.0f, mSSGIIntensityPlus), 0.0f, mSSGIIntensityMinus)
		* SSPT_IL_AMOUNT * lerp(1.0f, 2.5f, mDbgSSGIModeGain);

	float3 finalGi = avgRadiance * giGain;

	return float4(clamp(finalGi, 0.0f, 100.0f), saturate(avgOcclusion));
}

#endif // RAY_MMD_SSPT_TRACE_FXSUB
